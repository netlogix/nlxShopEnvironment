{
    "name": "netlogix/nlxshopenvironment",
    "description": "Plugin to dump/load configurations in a shopware shop to/from a file from/to the database",
    "type": "shopware-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "netlogix GmbH & Co. KG",
            "email": "websolutions@netlogix.de"
        }
    ],
    "extra": {
        "installer-name": "nlxShopEnvironment"
    },
    "autoload": {
        "psr-4": {
            "nlxShopEnvironment\\": "."
        }
    },
    "require": {
        "php": "^7.4||^8.0",
        "symfony/expression-language": "^4.3",
        "symfony/yaml": "^4.3"
    },
    "require-dev": {
        "shopware/shopware": "^5.7",
        "phpunit/phpunit": "^5.7"
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
